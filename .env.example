# Sign-in. Without these the editor still runs, saves locally, keeps its own backups and exports,only the account and the cloud copy are switched off.
AUTH_SECRET=
AUTH_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# namespaced under `gm:` so nothing here can collide with anything there.
REDIS_URL=

# Mongo is an alternative, and also adds no collection: point
# MONGODB_COLLECTION at one that already exists and every document written
# here is marked `_gm` and filtered on it. Leave both empty to use Redis.
MONGODB_URI=
MONGODB_COLLECTION=
MONGODB_DB=

# Optional. Salts the hash the rate limiter buckets callers by, so a raw IP
# address is never written into the shared Redis.
RATE_LIMIT_SALT=

# GIFs in the composer's picker, from KLIPY.
KLIPY=
