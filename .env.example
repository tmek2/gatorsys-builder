# Sign-in. Without these the editor still runs, saves locally, keeps its own
# backups and exports — only the account and the cloud copy are switched off.
#
# AUTH_SECRET is this deployment's own, not gatorsys.xyz's: Auth.js issues a
# host-only session cookie, so a session here could never be read there even
# with a matching secret. `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_URL=https://mockups.gatorsys.xyz
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The cloud copy and short share links.
#
# Redis is the store to use: it is the same instance the rest of Gator runs,
# it costs no MongoDB collection, and share links get a real TTL. Keys are
# namespaced under `gm:` so nothing here can collide with anything there.
REDIS_URL=

# Mongo is an alternative, and also adds no collection: point
# MONGODB_COLLECTION at one that already exists and every document written
# here is marked `_gm` and filtered on it. Leave both empty to use Redis.
MONGODB_URI=
MONGODB_COLLECTION=
MONGODB_DB=

# Optional. Salts the hash the rate limiter buckets callers by, so a raw IP
# address is never written into the shared Redis. Falls back to AUTH_SECRET,
# which any deployment that can sign somebody in already has — so there is
# nothing to set unless you want the two rotated separately.
RATE_LIMIT_SALT=

# GIFs in the composer's picker, from KLIPY. Discord's own picker is Tenor's,
# but Tenor v2 needs a Google Cloud key and has no anonymous tier; KLIPY hands
# out a key and serves both halves of the picker — the trending grid and the
# categories — from one API. Without this the GIF tab says it is not set up and
# the picker's other tabs carry on.
KLIPY=

# Nothing to set for the picture proxy at /api/media — it is what makes a GIF
# picked from KLIPY exportable, since a picture the browser fetched from
# another origin taints the canvas the export rasterises through. It fetches
# https only, refuses any host that resolves to a private address, and caps
# what it will read.
